  "license": "SEE LICENSE IN LICENSE.md",
  "mcpName": "com.selectorshub/selectorshub-mcp",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "playwright-core": "^1.63.0",
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/selectorshub/selectorshub-mcp.git"
